	(text_box "Closing the switch will pull EN to ground and disable the LDO and in turn disable power to the C6 module and the rest of the chip."
		(exclude_from_sim no)
		(at 208.28 150.4332 0)
		(size 30.48 12.1268)
		(margins 0.9525 0.9525 0.9525 0.9525)
